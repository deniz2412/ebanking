{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Ocelot": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Ocelot": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/gateway-.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}",
          "retainedFileCountLimit": 30
        }
      },
      {
        "Name": "GrafanaLoki",
        "Args": {
          "uri": "http://loki.monitoring.svc.cluster.local:3100",
          "labels": [
            {
              "key": "app",
              "value": "gateway-ocelot"
            },
            {
              "key": "environment",
              "value": "dev"
            }
          ],
          "propertiesAsLabels": [
            "level",
            "UserId",
            "RequestId"
          ],
          "httpClient": {
            "timeout": "00:00:30"
          }
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "gateway-ocelot",
      "Environment": "dev"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "Authority": "https://ebank.local/auth/realms/ebanking",
    "Audience": "api-gateway",
    "Issuer": "https://ebank.local/auth/realms/ebanking",
    "RequireHttpsMetadata": true,
    "ClientId": "api-gateway",
    "ClientSecret": "your-client-secret"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://ebank.local",
      "http://localhost:4200",
      "https://localhost:4200"
    ]
  },
  "RateLimiting": {
    "GlobalPolicy": "ip",
    "UserPolicy": "user"
  },
  "RequestSizeLimits": {
    "MaxRequestBodySizeMB": 10,
    "RequestTimeoutSeconds": 30,
    "KeepAliveTimeoutMinutes": 2
  },
  "Security": {
    "RequireHttps": true,
    "EnableHSTS": true,
    "HSTSMaxAgeSeconds": 31536000,
    "IncludeSubdomains": true
  },
  "Monitoring": {
    "HealthChecks": {
      "Enabled": true,
      "Endpoints": [
        "/healthz",
        "/health/ready",
        "/health/live"
      ]
    },
    "Metrics": {
      "Enabled": true,
      "Endpoint": "/metrics"
    }
  }
}
