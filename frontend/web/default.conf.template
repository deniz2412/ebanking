# nginx:alpine runs envsubst on this template at start, substituting ${GATEWAY_URL}
# (the Ocelot gateway upstream — 'gateway' in compose, 'api-gateway' in k8s). nginx's own
# runtime vars ($host, $remote_addr, …) are not env vars, so they are left untouched.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass ${GATEWAY_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /config.json {
        add_header Cache-Control "no-store";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
