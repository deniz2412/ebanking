FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS base
WORKDIR /app
EXPOSE 8080

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# MSBuild walks up from a project's directory looking for Directory.Build.props; without
# this copy, the NuGet vulnerability pins it carries (see repo root) silently never apply
# inside the image, even though local `dotnet restore` from the repo root picks them up.
COPY Directory.Build.props ./

# Copy shared project first
COPY services/shared/ ./shared/

# Copy audit service project file and restore dependencies
COPY services/audit/AuditService.csproj ./audit/
RUN dotnet restore ./audit/AuditService.csproj

# Copy audit service source code
COPY services/audit/ ./audit/
WORKDIR /src/audit
RUN dotnet build AuditService.csproj -c Release -o /app/build

FROM build AS publish
RUN dotnet publish AuditService.csproj -c Release -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .

# Create logs directory, owned by the non-root user we switch to below
RUN mkdir -p logs && chown -R $APP_UID logs

USER $APP_UID
ENTRYPOINT ["dotnet", "AuditService.dll"]