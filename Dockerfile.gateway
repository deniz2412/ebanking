FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS base
WORKDIR /app
EXPOSE 8080

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# MSBuild walks up from a project's directory looking for Directory.Build.props; without
# this copy, the NuGet vulnerability pins it carries (see repo root) silently never apply
# inside the image, even though local `dotnet restore` from the repo root picks them up.
COPY Directory.Build.props ./

# Copy shared project first
COPY services/shared/ ./shared/

# Copy gateway project file and restore dependencies
COPY services/gateway-ocelot/gateway-ocelot.csproj ./gateway/
RUN dotnet restore ./gateway/gateway-ocelot.csproj

# Copy gateway source code
COPY services/gateway-ocelot/ ./gateway/
WORKDIR /src/gateway
RUN dotnet build gateway-ocelot.csproj -c Release -o /app/build

FROM build AS publish
RUN dotnet publish gateway-ocelot.csproj -c Release -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .

USER $APP_UID
ENTRYPOINT ["dotnet", "gateway-ocelot.dll"]