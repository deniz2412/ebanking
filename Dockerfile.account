FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS base
WORKDIR /app
EXPOSE 8080

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# MSBuild walks up from a project's directory looking for Directory.Build.props; without
# this copy, the NuGet vulnerability pins it carries (see repo root) silently never apply
# inside the image, even though local `dotnet restore` from the repo root picks them up.
COPY Directory.Build.props ./

# Copy shared project first
COPY services/shared/ ./shared/

# Copy account service project file and restore dependencies
COPY services/account/AccountService.csproj ./account/
RUN dotnet restore ./account/AccountService.csproj

# Copy account service source code
COPY services/account/ ./account/
WORKDIR /src/account
RUN dotnet build AccountService.csproj -c Release -o /app/build

FROM build AS publish
RUN dotnet publish AccountService.csproj -c Release -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .

# Create logs directory, owned by the non-root user we switch to below
RUN mkdir -p logs && chown -R $APP_UID logs

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

USER $APP_UID
ENTRYPOINT ["dotnet", "AccountService.dll"]