FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS base
WORKDIR /app
EXPOSE 8080

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# MSBuild walks up from a project's directory looking for Directory.Build.props; without
# this copy, the NuGet vulnerability pins it carries (see repo root) silently never apply
# inside the image, even though local `dotnet restore` from the repo root picks them up.
COPY Directory.Build.props ./

# Copy shared project first
COPY services/shared/ ./shared/

# Copy notification service project file and restore dependencies
COPY services/notification/NotificationService.csproj ./notification/
RUN dotnet restore ./notification/NotificationService.csproj

# Copy notification service source code
COPY services/notification/ ./notification/
WORKDIR /src/notification
RUN dotnet build NotificationService.csproj -c Release -o /app/build

FROM build AS publish
RUN dotnet publish NotificationService.csproj -c Release -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .

# Create logs directory, owned by the non-root user we switch to below
RUN mkdir -p logs && chown -R $APP_UID logs

USER $APP_UID
ENTRYPOINT ["dotnet", "NotificationService.dll"]